@{
    ViewBag.Title = "Pagina de cálculadora básica";
}
<h1>Bienvenido a la @ViewData["Title"]</h1>


<form asp-controller="Home"
      method="post">
    Numero 1 : <input name="n1" type="text" /> <br /><br />
    Numero 2 : <input name="n2" type="text" @if (ViewBag.Action == "RaizCuadrada")
                      {
        <text>disabled</text>
    }
    /> <br /><br />

    <input type="submit" value="+" asp-action="Sumar" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="-" asp-action="Restar" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="x" asp-action="Multiplicacion" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="/" asp-action="Division" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="√" asp-action="RaizCuadrada" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="%" asp-action="Modulo" /> &nbsp;&nbsp;&nbsp;
    <input type="submit" value="^" asp-action="Potencia" />


</form>

<h2 style="color:crimson; background-color:darksalmon; padding:10px;">
    @ViewBag.Result
</h2>